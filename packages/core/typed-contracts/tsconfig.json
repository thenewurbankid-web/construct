{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node", "react"],
    "typeRoots": ["../../../node_modules/@types"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts"],
  "exclude": [
    "examples/invalid-wiring.ts",
    "examples/implicit-return.ts",
    "examples/feature-branded-invalid.ts",
    "examples/expression-implicit-return.ts"
  ]
}
