// ---------------------------------------------------------------------------
// A fourteenth feature -- basic recursion. Tested first, expecting it to
// break: it does, immediately and unconditionally. and(a, recurse()) as a
// plain orelseIs() argument calls the recursive branch EAGERLY regardless
// of whether the base case already matched (same root cause as the
// eager-argument crash from before, but here it's not just wrong values --
// it's an unconditional recursive call, so a real base case would recurse
// forever, not just throw once). Recursion is a hard boundary, same
// category as try/catch: it needs genuine deferred control flow, which
// only a real if/else (or an explicit closure) can provide. No named-
// variable extraction fixes this -- there's no way to "pre-compute" a call
// that must conditionally not happen at all.
// ---------------------------------------------------------------------------

function allValidNamed(statuses: TextValue[]): boolean {
  if (statuses.length === 0) {
    return true;
  } else {
    return and(statuses[0].equals(new TextValue('valid')), allValidNamed(statuses.slice(1)));
  }
}

console.log(allValidNamed([])); // true
console.log(allValidNamed([new TextValue('valid'), new TextValue('valid')])); // true
console.log(allValidNamed([new TextValue('valid'), new TextValue('invalid')])); // false

