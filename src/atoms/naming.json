{
  "$comment": "Naming rule for generated atoms (scripts/gen-atoms.mjs). Order: overrides > aliases > curated `covers` (hand-written names win) > rule. A name collision fails the build.",
  "booleanPrefixes": [
    "is",
    "has",
    "can",
    "should",
    "does"
  ],
  "booleanFallbackPrefix": "does",
  "booleanExempt": [
    "equals",
    "differs",
    "lessThan",
    "atMost",
    "greaterThan",
    "atLeast",
    "not",
    "and",
    "or"
  ],
  "rule": {
    "instance": "{verb}{Noun}",
    "static": "{verb}{StaticNoun}",
    "getter": "get<Rest> -> {rest}Of{Noun} (static: {rest}Of; a Rest already ending in Of keeps one Of)",
    "setter": "set<Rest> on a copy -> {noun}With{Rest}",
    "staticFrom": "from<Rest> (static) -> {noun}From{Rest}",
    "dropTo": "to<Rest> -> {rest}{Noun} for the methods listed in dropTo",
    "mutator": "mutating method -> {participle}{Noun}, returning the mutated COPY",
    "boolean": "a boolean or type-guard result whose name lacks a booleanPrefixes prefix gets booleanFallbackPrefix + Name",
    "UTC": "a leading UTC becomes utc"
  },
  "dropTo": [
    "toLocaleLowerCase",
    "toLocaleUpperCase",
    "toFixed",
    "toExponential",
    "toPrecision",
    "toSpliced"
  ],
  "renames": {
    "includes": "has{Noun}",
    "indexOf": "positionOf{Noun}",
    "lastIndexOf": "lastPositionOf{Noun}",
    "findLast": "lastWhere",
    "findLastIndex": "lastPositionWhere",
    "forEach": "each{Noun}",
    "entries": "entriesOf{Noun}",
    "keys": "keysOf{Noun}",
    "values": "valuesOf{Noun}",
    "toString": "{noun}AsText",
    "toLocaleString": "{noun}AsLocaleText",
    "toDateString": "{noun}AsDateText",
    "toTimeString": "{noun}AsTimeText",
    "toLocaleDateString": "{noun}AsLocaleDateText",
    "toLocaleTimeString": "{noun}AsLocaleTimeText",
    "toUTCString": "{noun}AsUtcText",
    "toISOString": "{noun}AsIsoText",
    "toJSON": "{noun}AsJson",
    "valueOf": "primitiveOf{Noun}",
    "of": "{noun}Of",
    "get": "getFrom{Noun}"
  },
  "participles": {
    "push": "pushed",
    "pop": "popped",
    "shift": "shifted",
    "unshift": "unshifted",
    "fill": "filled",
    "copyWithin": "copiedWithin",
    "clear": "emptied",
    "freeze": "frozen",
    "seal": "sealed",
    "preventExtensions": "nonExtensible",
    "defineProperty": "withProperty",
    "defineProperties": "withProperties",
    "setPrototypeOf": "withPrototype"
  },
  "mutatorEquivalents": {
    "Array#splice": "Array#toSpliced",
    "Array#sort": "Array#toSorted",
    "Array#reverse": "Array#toReversed"
  },
  "overrides": {
    "Object.is": "isSameValue",
