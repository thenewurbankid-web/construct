  "syntax": [
    {
      "js": "return",
      "reason": "stays as syntax: a function's result"
    },
    {
      "js": "function",
      "reason": "stays as syntax: declares a function"
    },
    {
      "js": "=>",
      "reason": "stays as syntax: the thunks the atoms take"
    },
    {
      "js": "class",
      "reason": "stays as syntax: declares a type"
    },
    {
      "js": "await",
      "reason": "stays as syntax: suspends an async function"
    },
    {
      "js": "yield",
      "reason": "stays as syntax: suspends a generator"
    },
    {
      "js": "label:",
      "reason": "stays as syntax: labels can't be values"
    },
    {
      "js": "get x() / set x(v)",
      "reason": "stays as syntax: accessors are declarations"
    },
    {
      "js": "const { a, b } = obj",
      "reason": "stays as syntax: destructuring binds names"
    },
    {
      "js": "...spread",
      "reason": "stays as syntax in calls and literals; merged/concatenated cover the copy idioms"
    },
    {
      "js": "new",
      "reason": "stays as syntax for user classes; built-in constructors have From atoms"
    },
    {
      "js": "this / super",
      "reason": "stays as syntax: atoms work on plain data passed in explicitly"
    },
    {
      "js": "import / export",
      "reason": "stays as syntax: module structure"
    },
    {
      "js": "let / const / var",
      "reason": "stays as syntax: bindings"
    },
    {
      "js": "typeof",
      "reason": "covered by isText / isNumber / isBoolean / isNothing; other typeof checks stay as syntax"
    },
    {
      "js": "delete obj[k]",
      "reason": "covered by withoutKey (copy); in-place delete stays as syntax"
    },
    {
      "js": "for / for\u2026of / for\u2026in",
      "reason": "covered by each / mapEach / repeatWhile; a loop with break/continue stays as syntax"
    },
    {
      "js": "break / continue",
      "reason": "stays as syntax: loop control"
    },
    {
      "js": "void / comma operator",
      "reason": "stays as syntax: low app use"
    },
    {
      "js": "++ / -- / += and other compound assignment",
      "reason": "stays as syntax: assignment to a binding; use plus/minus and rebind"
    },
    {
      "js": "x = y",
      "reason": "stays as syntax: assignment; copy atoms (withKey, replacedAt) replace mutation"
    },
    {
      "js": "in",
      "reason": "not an atom: inherited keys make it unsafe on plain data; hasKey covers own keys"
    },
    {
      "js": "a?.b()",
      "reason": "optional call stays as syntax; get/at cover optional reads"
    },
    {
      "js": "template literal `${a}`",
      "reason": "stays as syntax (join covers a + b)"
    },
    {
      "js": "bitwise & | ^ ~ << >> >>>",
      "reason": "stays as syntax: low app use"
    }
  ],
