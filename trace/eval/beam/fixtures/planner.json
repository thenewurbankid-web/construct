  "Show the total value of all orders in the header next to the order count.": {
    "runs": [
      {
        "id": "run-static",
        "labels": {
          "intent": "update.prop",
          "object": "prop",
          "target": {
            "kind": "page",
            "name": "orders"
          },
          "layers": [
            "ui",
            "api"
          ],
          "by": "static"
        },
        "path": [
          {
            "layer": "page-part",
            "label": "totalValue (header)",
            "decision": "dynamic"
          },
          {
            "layer": "source",
            "label": "GET /api/orders/total",
            "decision": "api",
            "picks": {
              "static": "api",
              "jev": "computed"
            },
            "fork": true
          },
          {
            "layer": "controller",
            "label": "OrdersController.totalValue",
            "decision": "create"
          },
          {
            "layer": "service",
            "label": "ordersService.total",
            "decision": "create"
          },
          {
            "layer": "contract",
            "label": "GET /api/orders/total",
            "decision": "create"
          }
        ]
      },
      {
        "id": "run-jev",
        "labels": {
          "intent": "update.prop",
          "object": "prop",
          "target": {
            "kind": "page",
            "name": "orders"
          },
          "layers": [
            "ui"
          ],
          "by": "jev"
        },
        "path": [
          {
            "layer": "page-part",
            "label": "totalValue (header)",
            "decision": "dynamic"
          },
          {
            "layer": "source",
            "label": "sum of orders[].total",
            "decision": "computed",
            "picks": {
              "static": "api",
              "jev": "computed"
            },
            "fork": true
          },
          {
            "layer": "controller",
            "label": "OrdersController.orders",
            "decision": "fn"
          },
          {
            "layer": "hook",
            "label": "useOrderTotals(orders)",
            "decision": "create"
          },
          {
            "layer": "contract",
            "label": "GET /api/orders",
            "decision": "fn"
          }
        ]
      }
    ],
    "recommended": "run-jev",
    "question": {
      "text": "Should the total value come from an api field or be computed from the orders on the page?",
      "options": [
        "an api field",
        "computed from the orders"
      ]
    }
  },
