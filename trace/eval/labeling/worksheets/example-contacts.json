      "moneyFull": "1200 -> $1,200",
      "percent": "0.327 -> 32.7%",
      "percentWhole": "0.327 -> 33%"
    },
    "rules": [
      "Decide from the design text and the contract only. Do not run Trace and do not open answers.json, decisions.json or ai-cache.json.",
