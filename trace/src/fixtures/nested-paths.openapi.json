            "description": "gone"
          }
        }
      }
    },
    "/api/regions/{region}/stores/{store}/stock": {
      "get": {
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "example": [
                  {
                    "sku": "a",
                    "qty": 1
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
