{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://construct.dev/schemas/unit-summary.v1.json",
  "title": "Construct Unit Summary v1",
  "description": "Deterministic, LLM-free structured summary of one unit (project, feature, layer, file, component, hook, service, domain, page, controller, workflow, export, route, package, rule, envelope, generator) as returned by summarizeUnit() in src/engine/unitSummary.mjs, `construct summarize <ref>` and GET /api/units/summary. Also describes the list, feature-index and error results. The common envelope is fixed; `sections` is a per-`kind` object (see docs/unit-summary.md). Breaking changes go in unit-summary.v2.json.",
  "oneOf": [
    { "$ref": "#/definitions/summary" },
    { "$ref": "#/definitions/unitList" },
    { "$ref": "#/definitions/featureList" },
    { "$ref": "#/definitions/error" }
  ],
  "definitions": {
    "detail": { "type": "string", "enum": ["brief", "standard", "full"] },
    "finding": {
      "type": "object",
      "required": ["severity", "message"],
      "properties": {
        "severity": { "type": "string", "enum": ["error", "warning", "info"] },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "health": {
      "type": "object",
      "required": ["status", "findings"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "warnings", "issues"], "description": "issues = at least one error finding; warnings = at least one warning; ok otherwise (info findings do not change status)." },
        "findings": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1, "description": "Features only: fraction of the core layers present." }
      }
    },
    "next": {
      "type": "object",
      "required": ["ref", "why", "cli"],
      "properties": { "ref": { "type": "string" }, "why": { "type": "string" }, "cli": { "type": "string" } }
    },
    "summary": {
      "type": "object",
      "required": ["schemaVersion", "ok", "kind", "id", "ref", "name", "detail", "summary", "sections", "health", "links", "next", "budget"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "ok": { "const": true },
        "kind": { "type": "string", "minLength": 1, "description": "Unit kind discriminator: project, feature, layer, file, component, hook, service, domain, page, controller, workflow, export, route, package, rule, envelope, generator (registry-extensible)." },
        "id": { "type": "string" },
        "ref": { "type": "string", "description": "Always `kind:id`; pass it back to summarizeUnit to re-address the unit unambiguously." },
        "name": { "type": "string" },
        "path": { "type": "string", "description": "Project-relative path when the unit maps to one." },
        "detail": { "$ref": "#/definitions/detail" },
        "summary": { "type": "string", "description": "One plain-English paragraph." },
        "sections": { "type": "object", "description": "Per-kind sections; keys depend on `kind`. Feature summaries carry `flow` (see #/definitions/flow)." },
        "health": { "$ref": "#/definitions/health" },
        "links": {
          "type": "object",
          "properties": { "parent": { "type": "string" }, "children": { "type": "array", "items": { "type": "string" } } }
        },
        "next": { "type": "array", "items": { "$ref": "#/definitions/next" } },
        "budget": {
          "type": "object",
          "required": ["maxTokens", "estimatedTokens", "truncated"],
          "properties": {
            "maxTokens": { "type": "integer", "description": "brief 500, standard 2000, full 8000 (tokens ~= JSON chars / 4)." },
            "estimatedTokens": { "type": "integer" },
            "truncated": { "type": "boolean" },
            "omitted": { "type": "object", "additionalProperties": { "type": "integer" }, "description": "sections path -> number of array items dropped to fit the budget." },
            "exceeded": { "type": "boolean" }
          }
        }
      }
    },
    "unitList": {
      "type": "object",
      "required": ["schemaVersion", "ok", "count", "units"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "ok": { "const": true },
        "kind": { "type": "string" },
        "kinds": { "type": "array", "items": { "type": "object", "required": ["kind", "description", "count"], "properties": { "kind": { "type": "string" }, "description": { "type": "string" }, "count": { "type": "integer" } } } },
        "count": { "type": "integer" },
        "units": { "type": "array", "items": { "type": "object", "required": ["kind", "id", "name", "ref"], "properties": { "kind": { "type": "string" }, "id": { "type": "string" }, "name": { "type": "string" }, "path": { "type": "string" }, "ref": { "type": "string" } } } }
      }
    },
    "featureList": {
      "type": "object",
      "required": ["schemaVersion", "ok", "count", "features"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "ok": { "const": true },
        "count": { "type": "integer" },
        "features": { "type": "array", "items": { "type": "object", "required": ["name", "ref"], "properties": { "name": { "type": "string" }, "path": { "type": "string" }, "ref": { "type": "string" }, "summary": { "type": "string" }, "health": { "type": "string" }, "completeness": { "type": "number" } } } }
      }
    },
    "flowNode": {
      "type": "object",
      "required": ["file", "layer"],
      "additionalProperties": false,
      "description": "One file in a flow tree. `feature` is present only when the file belongs to a different feature than the one summarized (e.g. a shared component). `shownAbove` marks a file already drawn earlier in the same route tree (it has no children there). types.ts and index.ts never appear.",
      "properties": {
        "file": { "type": "string" },
        "layer": { "type": "string" },
        "feature": { "type": "string" },
        "purpose": { "type": "string", "description": "detail=full only." },
        "shownAbove": { "const": true },
        "children": { "type": "array", "items": { "$ref": "#/definitions/flowNode" }, "description": "What this file imports, in the file's own import order." }
      }
    },
    "flowController": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "description": "A controller under a route: `layer` plus the branches (each present only when non-empty). A controller reached by several routes repeats under each route.",
      "properties": {
        "file": { "type": "string" },
        "layer": { "const": "controller" },
        "behaviour": { "type": "array", "items": { "$ref": "#/definitions/flowNode" }, "description": "hook, workflow, service, domain." },
        "render": { "type": "array", "items": { "$ref": "#/definitions/flowNode" }, "description": "page, component." },
        "other": { "type": "array", "items": { "$ref": "#/definitions/flowNode" }, "description": "Imports in any other layer." }
      }
    },
    "flow": {
      "type": "object",
      "required": ["framework", "routeAdapter", "routes", "notes"],
      "additionalProperties": false,
      "description": "Feature `sections.flow` (#328; detail standard and full, omitted at brief, whose ~500-token budget has no headroom: use contracts.routes there). Routes are the roots; a route rendering controllers from several features is a fan-out (`fanOut`), its features ordered by the route file's import order. Drawn from the real import graph. `routes` is empty, with a `no-route-adapter` note, for a framework without a route adapter (never a guess); a feature no route reaches gets an info-level `no-route` note.",
      "properties": {
        "framework": { "type": "string" },
        "routeAdapter": { "type": "boolean", "description": "False when the project's framework has no route adapter." },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["route", "file", "fanOut", "features"],
            "additionalProperties": false,
            "properties": {
              "route": { "type": "string" },
              "file": { "type": "string", "description": "The route file: a Next.js page.tsx, or the react-spa route table." },
              "fanOut": { "type": "boolean" },
              "features": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["feature", "self", "ref", "controllers"],
                  "additionalProperties": false,
                  "properties": {
                    "feature": { "type": "string" },
                    "self": { "type": "boolean", "description": "True for the summarized feature." },
                    "ref": { "type": "string" },
                    "controllers": { "type": "array", "items": { "$ref": "#/definitions/flowController" } }
                  }
                }
              }
            }
          }
        },
        "notes": { "type": "array", "items": { "$ref": "#/definitions/finding" }, "description": "Info-level notes: no-route, no-route-adapter." }
      }
    },
    "error": {
      "type": "object",
      "required": ["schemaVersion", "ok", "error"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "enum": ["INVALID_ARGUMENT", "UNKNOWN_KIND", "ROOT_NOT_FOUND", "UNIT_NOT_FOUND", "UNIT_AMBIGUOUS", "INTERNAL_ERROR"] },
            "message": { "type": "string" },
            "candidates": { "type": "array", "items": { "type": "object", "required": ["kind", "id", "ref"], "properties": { "kind": { "type": "string" }, "id": { "type": "string" }, "ref": { "type": "string" } } }, "description": "UNIT_AMBIGUOUS: the units the reference matched. UNIT_NOT_FOUND: close suggestions." },
            "hint": { "type": "string" },
            "validKinds": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
