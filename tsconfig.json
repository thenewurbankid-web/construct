{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["packages/core/**/*.mjs", "packages/cli/**/*.mjs", "packages/ast/**/*.mjs", "packages/engine/**/*.mjs"],
  "exclude": ["node_modules", "test", "test.mjs", "**/*.test.mjs"]
}
