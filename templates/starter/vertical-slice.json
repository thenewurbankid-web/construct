{
  "templateVersion": 1,
  "name": "starter.vertical-slice",
  "description": "Scaffold a standard vertical feature slice: a new feature plus one unit across all seven layers (domain, service, workflow, hook, component, page, controller), in dependency order.",
  "parameters": {
    "feature": { "type": "identifier", "description": "Feature slice name, kebab or snake case.", "example": "billing" },
    "name": { "type": "identifier", "description": "Unit name, PascalCase.", "example": "Invoice" }
  },
  "ticket": { "source": "text", "title": "Add the {{feature}} feature" },
  "summary": "Create the {{feature}} feature and scaffold {{name}} across domain, service, workflow, hook, component, page and controller.",
  "steps": [
    {
      "id": "create-feature",
      "title": "Create the {{feature}} feature",
      "flow": "create.feature",
      "args": { "name": "{{feature}}" },
      "executor": "deterministic",
      "touches": { "features": ["{{feature}}"] }
    },
    {
      "id": "create-slice",
      "title": "Scaffold {{name}} across every layer",
      "flow": "create.layer",
      "args": {
        "name": "{{name}}",
        "feature": "{{feature}}",
        "layers": ["domain", "service", "workflow", "hook", "component", "page", "controller"]
      },
      "executor": "deterministic",
      "dependsOn": ["create-feature"],
      "touches": { "features": ["{{feature}}"] }
    }
  ]
}
